    modelDirectory="/org.sharedmobility.domainmodel/src" creationIcons="false"
    editDirectory="/org.sharedmobility.domainmodel.edit/src" editorDirectory="/org.sharedmobility.domainmodel.editor/src"
    modelPluginID="org.sharedmobility.domainmodel" modelName="Domainmodel" rootExtendsClass="org.eclipse.emf.ecore.impl.MinimalEObjectImpl$Container"
    suppressEMFTypes="true" codeFormatting="true" importerID="org.eclipse.emf.importer.ecore"
    complianceLevel="5.0" copyrightFields="false" usedGenPackages="../../tools.mdsd.modelingfoundations.identifier/model/identifier.genmodel#//identifier"
    operationReflection="true" importOrganizing="true">
  <foreignModel>domainmodel.ecore</foreignModel>
  <testsDirectory xsi:nil="true"/>
  <genPackages prefix="Domainmodel" basePackage="org.sharedmobility" disposableProviderFactory="true"
      ecorePackage="domainmodel.ecore#/">
    <genClasses ecoreClass="domainmodel.ecore#//Domain">
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference domainmodel.ecore#//Domain/vehicles"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference domainmodel.ecore#//Domain/participants"/>
      <genFeatures property="None" children="true" createChild="true" ecoreFeature="ecore:EReference domainmodel.ecore#//Domain/drivers"/>
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference domainmodel.ecore#//Domain/publicAgencies"/>
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference domainmodel.ecore#//Domain/mobilityServiceProvider"/>
      <genFeatures notify="false" createChild="false" propertySortChoices="true" ecoreFeature="ecore:EReference domainmodel.ecore#//Domain/roadsideUnits"/>
    </genClasses>
    <nestedGenPackages prefix="Communication" basePackage="org.sharedmobility.domainmodel"
        disposableProviderFactory="true" ecorePackage="domainmodel.ecore#//communication">
      <genClasses image="false" ecoreClass="domainmodel.ecore#//communication/NetworkConnector"/>
      <genClasses image="false" ecoreClass="domainmodel.ecore#//communication/NetworkCommunicator"/>
      <genClasses image="false" ecoreClass="domainmodel.ecore#//communication/DirectCommunicator">
        <genFeatures notify="false" createChild="false" propertySortChoices="true"
            ecoreFeature="ecore:EReference domainmodel.ecore#//communication/DirectCommunicator/communicationPartmers"/>
      </genClasses>
    </nestedGenPackages>
    <nestedGenPackages prefix="Ridepooling" basePackage="org.sharedmobility.domainmodel"
