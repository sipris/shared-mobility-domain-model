      <genClasses image="false" ecoreClass="domainmodel.ecore#//infrastructure/RoadsideUnit"/>
    </nestedGenPackages>
    <nestedGenPackages prefix="Base" basePackage="org.sharedmobility.domainmodel"
        disposableProviderFactory="true" ecorePackage="domainmodel.ecore#//base">
      <genClasses image="false" ecoreClass="domainmodel.ecore#//base/Vehilce">
