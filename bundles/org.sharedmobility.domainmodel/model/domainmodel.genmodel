      <genClasses ecoreClass="domainmodel.ecore#//ridepooling/User"/>
    </nestedGenPackages>
    <nestedGenPackages prefix="Infrastructure" basePackage="org.sharedmobility.domainmodel"
        disposableProviderFactory="true" ecorePackage="domainmodel.ecore#//infrastructure">
      <genEnums typeSafeEnumCompatible="false" ecoreEnum="domainmodel.ecore#//infrastructure/TraficLightState">
        <genEnumLiterals ecoreEnumLiteral="domainmodel.ecore#//infrastructure/TraficLightState/stop"/>
        <genEnumLiterals ecoreEnumLiteral="domainmodel.ecore#//infrastructure/TraficLightState/go"/>
      </genEnums>
      <genClasses ecoreClass="domainmodel.ecore#//infrastructure/TraficLight">
